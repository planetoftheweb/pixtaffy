# Copy to functions/.env.<projectId> (for example functions/.env.brandoit).
# Real env files are gitignored, except the non-secret staging config. Never commit secrets.
#
# Backend selection uses the committed project map in src/aiAssistBackend.ts because
# firebase-tools does not load .env files during source discovery.
# pixtaffy-staging and brandoit (prod) map to vertex; unknown projects use apikey.
# AI_ASSIST_BACKEND is unused. Unknown or missing project IDs use apikey.
# Staging uses pixtaffy-aiassist-runtime@pixtaffy-staging.iam.gserviceaccount.com via the committed map.
# Prod uses pixtaffy-aiassist-runtime@brandoit.iam.gserviceaccount.com. Runtime settings cannot override the identity.
# Vertex uses Application Default Credentials from the function service account.
# These Vertex settings are runtime-only:
# AI_ASSIST_VERTEX_LOCATION=global (default global)
# AI_ASSIST_VERTEX_MODEL=gemini-3.8-flash (default gemini-3.8-flash)
#
# Stripe price IDs used by createCheckout (each looks like price_...).
# These are public config, not secrets. Leave a value empty to fall back to
# the products collection in Firestore. Do not put a fake price_ value here:
# any value starting with price_ is sent to Stripe as is.
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_300=
STRIPE_PRICE_PRO_MONTHLY=
