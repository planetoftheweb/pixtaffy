# Copy to functions/.env.<projectId> (for example functions/.env.brandoit).
# Real env files are gitignored. Never commit them.
#
# Stripe price IDs used by createCheckout. These are public config, not secrets.
# If unset, createCheckout falls back to the products collection in Firestore.
STRIPE_PRICE_CREDITS_25=price_xxx
STRIPE_PRICE_CREDITS_100=price_xxx
STRIPE_PRICE_CREDITS_300=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
