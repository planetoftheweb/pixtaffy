{
  "name": "functions",
  "description": "Cloud Functions for PixTaffy",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test lib/**/*.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^1.33.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.35.5",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "typescript": "^5.5.4"
  },
  "private": true
}
