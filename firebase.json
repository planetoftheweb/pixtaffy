{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "pixtaffy",
      "public": "dist",
      "predeploy": ["node scripts/check-hosting-env.mjs --dist"],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/pricing",
          "destination": "/index.html"
        },
        {
          "source": "/privacy",
          "destination": "/index.html"
        },
        {
          "source": "/terms",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/studio",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/app",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/create",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/login",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/signin",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/sign-in",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/signup",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/sign-up",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/register",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/home",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/index",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/whats-new",
          "destination": "/?whatsnewpage=1",
          "type": 301
        },
        {
          "source": "/whatsnew",
          "destination": "/?whatsnewpage=1",
          "type": 301
        },
        {
          "source": "/changelog",
          "destination": "/?whatsnewpage=1",
          "type": 301
        },
        {
          "source": "/releases",
          "destination": "/?whatsnewpage=1",
          "type": 301
        },
        {
          "source": "/updates",
          "destination": "/?whatsnewpage=1",
          "type": 301
        },
        {
          "source": "/billing",
          "destination": "/pricing",
          "type": 301
        },
        {
          "source": "/checkout",
          "destination": "/pricing",
          "type": 301
        },
        {
          "source": "/plans",
          "destination": "/pricing",
          "type": 301
        },
        {
          "source": "/credits",
          "destination": "/pricing",
          "type": 301
        },
        {
          "source": "/buy",
          "destination": "/pricing",
          "type": 301
        },
        {
          "source": "/privacy-policy",
          "destination": "/privacy",
          "type": 301
        },
        {
          "source": "/legal/privacy",
          "destination": "/privacy",
          "type": 301
        },
        {
          "source": "/tos",
          "destination": "/terms",
          "type": 301
        },
        {
          "source": "/terms-of-service",
          "destination": "/terms",
          "type": 301
        },
        {
          "source": "/terms-of-use",
          "destination": "/terms",
          "type": 301
        },
        {
          "source": "/legal/terms",
          "destination": "/terms",
          "type": 301
        },
        {
          "source": "/favicon.ico",
          "destination": "/pixtaffy.png",
          "type": 302
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
