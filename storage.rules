rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRegistered() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isRegistered() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/{profileFile} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if profileFile.matches('profile\\.[A-Za-z0-9]+')
        && (isOwner(uid) || isAdmin())
        && isImageUpload(5 * 1024 * 1024);
      allow delete: if profileFile.matches('profile\\.[A-Za-z0-9]+')
        && (isOwner(uid) || isAdmin());
    }

    match /users/{uid}/history/{generationId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isImageUpload(25 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Everything else: admins only.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
